            snprintf(q,sizeof q,"SELECT p.id,u.full_name,p.basic_salary,p.allowances,p.deductions,(p.basic_salary+p.allowances-p.deductions) net FROM payroll p JOIN users u ON u.id=p.user_id WHERE p.user_id=%d",uid);
        if(mysql_query(db,q)){send_json(req->fd,500,"{\"error\":\"Database error\"}");goto done;}
        MYSQL_RES *res=mysql_store_result(db);MYSQL_ROW row;char out[30000];strcpy(out,"{\"records\":[");int first=1;
        while((row=mysql_fetch_row(res))){
            char e[6][300];for(int i=0;i<6;i++)json_escape(row[i]?row[i]:"",e[i],sizeof e[i]);
            char item[900];snprintf(item,sizeof item,"%s{\"id\":%s,\"full_name\":\"%s\",\"basic_salary\":%s,\"allowances\":%s,\"deductions\":%s,\"net\":%s}",first?"":",",e[0],e[1],e[2],e[3],e[4],e[5]);
            if(strlen(out)+strlen(item)+20<sizeof out)strcat(out,item);first=0;
        }
        strcat(out,"]}");mysql_free_result(res);send_json(req->fd,200,out);goto done;
    }

    if (!strcmp(req->path,"/api/payroll/update") && !strcmp(req->method,"POST")) {
        if(strcmp(role,"HR")){send_json(req->fd,403,"{\"error\":\"HR access required\"}");goto done;}
        int employee_user_id=0;char basic[50],allow[50],ded[50];
        if(!json_int(req->body,"user_id",&employee_user_id)||!json_string(req->body,"basic_salary",basic,sizeof basic)){send_json(req->fd,400,"{\"error\":\"Invalid payroll data\"}");goto done;}
        json_string(req->body,"allowances",allow,sizeof allow);json_string(req->body,"deductions",ded,sizeof ded);
        char q[900];snprintf(q,sizeof q,"INSERT INTO payroll(user_id,basic_salary,allowances,deductions) VALUES(%d,%s,%s,%s) ON DUPLICATE KEY UPDATE basic_salary=%s,allowances=%s,deductions=%s",employee_user_id,basic,*allow?allow:"0",*ded?ded:"0",basic,*allow?allow:"0",*ded?ded:"0");
        if(mysql_query(db,q))send_json(req->fd,400,"{\"error\":\"Could not update payroll\"}");
        else send_json(req->fd,200,"{\"message\":\"Payroll updated\"}");
        goto done;
    }

    send_json(req->fd,404,"{\"error\":\"API endpoint not found\"}");

done:
    mysql_close(db);
}

static void *client_thread(void *arg) {
    int fd=*(int*)arg;free(arg);
    Request req;memset(&req,0,sizeof req);req.fd=fd;

    char buf[BUF_SIZE];int n=recv(fd,buf,sizeof(buf)-1,0);
    if(n<=0){close(fd);return NULL;}buf[n]='\0';

    char *line_end=strstr(buf,"\r\n");
    if(!line_end){close(fd);return NULL;}
    sscanf(buf,"%15s %255s",req.method,req.path);

    char *headers_end=strstr(buf,"\r\n\r\n");
    int header_len=headers_end ? (int)(headers_end-buf+4) : n;
    if(headers_end){
        char *cl=strcasestr(buf,"Content-Length:");
        if(cl) {
            int content_len=atoi(cl+15);
            if(content_len>0 && content_len<(int)sizeof(req.body)-1) {
                int already=n-header_len;
                if(already>0)memcpy(req.body,buf+header_len,already);
                int total=already;
                while(total<content_len){
                    int r=recv(fd,req.body+total,content_len-total,0);
                    if(r<=0)break; total+=r;
                }
                req.body[total]='\0';
            }
        }
        char *ck=strcasestr(buf,"Cookie:");
        if(ck){ck+=7;while(*ck==' ')ck++;char *e=strstr(ck,"\r\n");if(e){size_t l=e-ck;if(l>=sizeof(req.cookie))l=sizeof(req.cookie)-1;memcpy(req.cookie,ck,l);req.cookie[l]='\0';}}
    }

    if(!strncmp(req.path,"/api/",5)) handle_api(&req);
    else serve_file(req.fd,req.path);

    close(fd);
    return NULL;
}

int main(void) {
    int server=socket(AF_INET,SOCK_STREAM,0);
    if(server<0){perror("socket");return 1;}
    int yes=1;setsockopt(server,SOL_SOCKET,SO_REUSEADDR,&yes,sizeof yes);

    struct sockaddr_in addr;memset(&addr,0,sizeof addr);
    addr.sin_family=AF_INET;addr.sin_addr.s_addr=INADDR_ANY;addr.sin_port=htons(SERVER_PORT);
    if(bind(server,(struct sockaddr*)&addr,sizeof addr)<0){perror("bind");return 1;}
    if(listen(server,50)<0){perror("listen");return 1;}

    printf("Dayflow HRMS running at http://localhost:%d\n",SERVER_PORT);
    printf("Frontend directory: %s\n",FRONTEND_DIR);

    while(1){
        struct sockaddr_in client;socklen_t len=sizeof client;
        int fd=accept(server,(struct sockaddr*)&client,&len);
        if(fd<0)continue;
        int *p=malloc(sizeof(int));*p=fd;
        pthread_t t;pthread_create(&t,NULL,client_thread,p);pthread_detach(t);
    }
    close(server);return 0;
}
