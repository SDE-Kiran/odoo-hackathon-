static void sha256_hex(const char *input, char out[65]) {
    unsigned char hash[SHA256_DIGEST_LENGTH];
    SHA256((const unsigned char*)input, strlen(input), hash);
    for (int i = 0; i < SHA256_DIGEST_LENGTH; i++)
        sprintf(out + i*2, "%02x", hash[i]);
    out[64] = '\0';
}

static void random_hex(char out[65]) {
    FILE *f = fopen("/dev/urandom", "rb");
    unsigned char b[32];
    if (f) {
        fread(b, 1, 32, f);
        fclose(f);
    } else {
        srand((unsigned)time(NULL) ^ (unsigned)getpid());
        for (int i=0;i<32;i++) b[i] = rand() & 255;
    }
    for (int i=0;i<32;i++) sprintf(out+i*2, "%02x", b[i]);
    out[64] = '\0';
}

static MYSQL *db_open(void) {
    MYSQL *db = mysql_init(NULL);
    if (!db) return NULL;
    if (!mysql_real_connect(db, DB_HOST, DB_USER, DB_PASSWORD,
                            DB_NAME, DB_PORT, NULL, 0)) {
        fprintf(stderr, "MySQL connection failed: %s\n", mysql_error(db));
        mysql_close(db);
        return NULL;
    }
    mysql_set_character_set(db, "utf8mb4");
    return db;
}

static void json_escape(const char *src, char *dst, size_t cap) {
    size_t j=0;
    for (size_t i=0; src && src[i] && j+2<cap; i++) {
        char c=src[i];
        if (c=='"' || c=='\\') { dst[j++]='\\'; dst[j++]=c; }
        else if (c=='\n') { dst[j++]='\\'; dst[j++]='n'; }
        else if ((unsigned char)c < 32) dst[j++]=' ';
        else dst[j++]=c;
    }
    dst[j]='\0';
}

static int json_string(const char *json, const char *key, char *out, size_t cap) {
    char needle[128];
    snprintf(needle, sizeof needle, "\"%s\"", key);
    const char *p = strstr(json, needle);
    if (!p) return 0;
    p = strchr(p + strlen(needle), ':');
    if (!p) return 0;
    p++;
    while (*p && isspace((unsigned char)*p)) p++;
    if (*p != '"') return 0;
    p++;
    size_t j=0;
    while (*p && *p!='"' && j+1<cap) {
        if (*p=='\\' && p[1]) p++;
        out[j++] = *p++;
    }
    out[j]='\0';
    return 1;
}

static int json_int(const char *json, const char *key, int *out) {
    char needle[128];
    snprintf(needle, sizeof needle, "\"%s\"", key);
    const char *p = strstr(json, needle);
    if (!p) return 0;
    p = strchr(p + strlen(needle), ':');
    if (!p) return 0;
    p++;
    *out = atoi(p);
    return 1;
}

static void send_raw(int fd, const char *status, const char *type,
                     const char *extra, const char *body) {
    char head[1024];
    int len = (int)strlen(body);
    snprintf(head, sizeof head,
             "HTTP/1.1 %s\r\n"
             "Content-Type: %s\r\n"
             "Content-Length: %d\r\n"
             "Access-Control-Allow-Origin: *\r\n"
             "Access-Control-Allow-Headers: Content-Type\r\n"
             "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
             "Connection: close\r\n"
             "%s\r\n",
             status, type, len, extra ? extra : "");
    send(fd, head, strlen(head), 0);
    send(fd, body, len, 0);
}

static void send_json(int fd, int code, const char *json) {
    const char *status = code==200 ? "200 OK" :
                         code==201 ? "201 Created" :
                         code==400 ? "400 Bad Request" :
                         code==401 ? "401 Unauthorized" :
                         code==403 ? "403 Forbidden" :
                         code==404 ? "404 Not Found" : "500 Internal Server Error";
    send_raw(fd, status, "application/json; charset=utf-8", "", json);
}

static void serve_file(int fd, const char *path) {
    char full[512];
    if (!strcmp(path, "/")) path = "/index.html";
    snprintf(full, sizeof full, "%s%s", FRONTEND_DIR, path);

    struct stat st;
    if (stat(full, &st) != 0 || !S_ISREG(st.st_mode)) {
        send_raw(fd, "404 Not Found", "text/plain", "", "Not found");
        return;
    }

    FILE *f = fopen(full, "rb");
    if (!f) { send_raw(fd, "500 Internal Server Error", "text/plain", "", "File error"); return; }
    char *data = malloc(st.st_size + 1);
    if (!data) { fclose(f); return; }
    fread(data, 1, st.st_size, f);
    fclose(f);
    data[st.st_size] = 0;

    const char *type = "text/plain";
    const char *ext = strrchr(path, '.');
    if (ext) {
        if (!strcmp(ext, ".html")) type="text/html; charset=utf-8";
        else if (!strcmp(ext, ".css")) type="text/css; charset=utf-8";
        else if (!strcmp(ext, ".js")) type="application/javascript; charset=utf-8";
        else if (!strcmp(ext, ".json")) type="application/json";
        else if (!strcmp(ext, ".svg")) type="image/svg+xml";
    }
    send_raw(fd, "200 OK", type, "", data);
    free(data);
}

static int get_session(MYSQL *db, const char *cookie, int *uid, char *role, size_t rolecap) {
    if (!cookie || !*cookie) return 0;
    char token[65] = {0};
    const char *p = strstr(cookie, "DAYFLOW_SESSION=");
    if (!p) return 0;
    p += strlen("DAYFLOW_SESSION=");
    size_t i=0;
    while (*p && *p!=';' && i<64) token[i++]=*p++;
    token[i]='\0';
    if (strlen(token)!=64) return 0;

    MYSQL_STMT *st = mysql_stmt_init(db);
    const char *sql =
        "SELECT u.id,u.role FROM sessions s JOIN users u ON u.id=s.user_id "
        "WHERE s.token=? AND s.expires_at>NOW()";
    if (!st || mysql_stmt_prepare(st, sql, strlen(sql))) { if(st)mysql_stmt_close(st); return 0; }

    MYSQL_BIND in[1]; memset(in,0,sizeof(in));
    in[0].buffer_type=MYSQL_TYPE_STRING; in[0].buffer=token; in[0].buffer_length=64;
    mysql_stmt_bind_param(st,in);
    if (mysql_stmt_execute(st)) { mysql_stmt_close(st); return 0; }

    MYSQL_BIND out[2]; memset(out,0,sizeof(out));
    int id=0; char r[20]={0}; unsigned long rl=0;
    out[0].buffer_type=MYSQL_TYPE_LONG; out[0].buffer=&id;
    out[1].buffer_type=MYSQL_TYPE_STRING; out[1].buffer=r; out[1].buffer_length=sizeof(r); out[1].length=&rl;
    mysql_stmt_bind_result(st,out);
    int ok = mysql_stmt_fetch(st)==0;
    if (ok) { *uid=id; snprintf(role,rolecap,"%s",r); }
    mysql_stmt_close(st);
    return ok;
}

