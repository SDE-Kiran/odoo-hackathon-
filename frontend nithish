<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dayflow HRMS</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    
    <div id="loginPage" class="auth-container">
        <div class="auth-box">
            <h1>Dayflow</h1>
            <p>Human Resource Management System</p>

            <form id="loginForm">
                <input
                    type="email"
                    id="loginEmail"
                    placeholder="Email"
                    required
                >

                <input
                    type="password"
                    id="loginPassword"
                    placeholder="Password"
                    required
                >

                <button type="submit">Sign In</button>
            </form>

            <p id="loginMessage"></p>

            <p>
                Don't have an account?
                <button class="link-btn" onclick="showSignup()">
                    Sign Up
                </button>
            </p>
        </div>
    </div>

    <div id="signupPage" class="auth-container hidden">
        <div class="auth-box">
            <h1>Create Account</h1>
            <p>Join Dayflow HRMS</p>

            <form id="signupForm">

                <input
                    type="text"
                    id="employeeId"
                    placeholder="Employee ID"
                    required
                >

                <input
                    type="text"
                    id="signupName"
                    placeholder="Full Name"
                    required
                >

                <input
                    type="email"
                    id="signupEmail"
                    placeholder="Email"
                    required
                >

                <input
                    type="password"
                    id="signupPassword"
                    placeholder="Password"
                    required
                >

                <select id="signupRole">
                    <option value="employee">Employee</option>
                    <option value="hr">HR</option>
                </select>

                <button type="submit">Create Account</button>
            </form>

            <p id="signupMessage"></p>

            <p>
                Already have an account?
                <button class="link-btn" onclick="showLogin()">
                    Sign In
                </button>
            </p>
        </div>
    </div>


   
    <div id="appPage" class="hidden">

        
        <aside class="sidebar">

            <h2>Dayflow</h2>

            <button onclick="showSection('dashboard')">
                Dashboard
            </button>

            <button onclick="showSection('profile')">
                Profile
            </button>

            <button onclick="showSection('attendance')">
                Attendance
            </button>

            <button onclick="showSection('leave')">
                Leave Requests
            </button>

            <button onclick="showSection('payroll')">
                Payroll
            </button>

            <div id="hrMenu" class="hidden">

                <hr>

                <button onclick="showSection('employees')">
                    Employees
                </button>

                <button onclick="showSection('leaveApproval')">
                    Leave Approval
                </button>

                <button onclick="showSection('allAttendance')">
                    All Attendance
                </button>

            </div>

            <button class="logout" onclick="logout()">
                Logout
            </button>

        </aside>


        
        <main class="content">

            
            <section id="dashboard" class="section">

                <h1>Dashboard</h1>

                <div class="welcome-card">
                    <h2>Welcome, <span id="userName"></span></h2>
                    <p id="userRole"></p>
                </div>

                <div class="cards">

                    <div class="card">
                        <h3>Attendance</h3>
                        <p>Manage your daily attendance.</p>
                        <button onclick="showSection('attendance')">
                            Open
                        </button>
                    </div>

                    <div class="card">
                        <h3>Leave</h3>
                        <p>Apply and track your leave.</p>
                        <button onclick="showSection('leave')">
                            Open
                        </button>
                    </div>

                    <div class="card">
                        <h3>Payroll</h3>
                        <p>View salary information.</p>
                        <button onclick="showSection('payroll')">
                            Open
                        </button>
                    </div>

                </div>

            </section>

            <section id="profile" class="section hidden">

                <h1>My Profile</h1>

                <div class="form-card">

                    <label>Name</label>
                    <input id="profileName" type="text" disabled>

                    <label>Email</label>
                    <input id="profileEmail" type="email" disabled>

                    <label>Employee ID</label>
                    <input id="profileEmployeeId" type="text" disabled>

                    <label>Phone</label>
                    <input id="profilePhone" type="text">

                    <label>Address</label>
                    <textarea id="profileAddress"></textarea>

                    <button onclick="updateProfile()">
                        Save Profile
                    </button>

                    <p id="profileMessage"></p>

                </div>

            </section>


            
            <section id="attendance" class="section hidden">

                <h1>Attendance</h1>

                <div class="attendance-actions">

                    <button onclick="checkIn()">
                        Check In
                    </button>

                    <button onclick="checkOut()">
                        Check Out
                    </button>

                </div>

                <p id="attendanceMessage"></p>

                <table>

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody id="attendanceTable"></tbody>

                </table>

            </section>


            
            <section id="leave" class="section hidden">

                <h1>Leave Requests</h1>

                <div class="form-card">

                    <h2>Apply for Leave</h2>

                    <select id="leaveType">
                        <option value="Paid">Paid Leave</option>
                        <option value="Sick">Sick Leave</option>
                        <option value="Unpaid">Unpaid Leave</option>
                    </select>

                    <label>Start Date</label>
                    <input type="date" id="leaveStart">

                    <label>End Date</label>
                    <input type="date" id="leaveEnd">

                    <textarea
                        id="leaveRemarks"
                        placeholder="Remarks"
                    ></textarea>

                    <button onclick="applyLeave()">
                        Apply Leave
                    </button>

                    <p id="leaveMessage"></p>

                </div>

                <h2>My Requests</h2>

                <table>

                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>

                    <tbody id="leaveTable"></tbody>

                </table>

            </section>


            
            <section id="payroll" class="section hidden">

                <h1>Payroll</h1>

                <table>

                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Basic Salary</th>
                            <th>Allowances</th>
                            <th>Deductions</th>
                            <th>Net Salary</th>
                        </tr>
                    </thead>

                    <tbody id="payrollTable"></tbody>

                </table>

            </section>


            
            <section id="employees" class="section hidden">

                <h1>Employee Directory</h1>

                <table>

                    <thead>
                        <tr>
                            <th>Employee ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                        </tr>
                    </thead>

                    <tbody id="employeesTable"></tbody>

                </table>

            </section>


            
            <section id="leaveApproval" class="section hidden">

                <h1>Leave Approval</h1>

                <table>

                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Type</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody id="leaveApprovalTable"></tbody>

                </table>

            </section>


            
            <section id="allAttendance" class="section hidden">

                <h1>All Attendance</h1>

                <table>

                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Date</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody id="allAttendanceTable"></tbody>

                </table>

            </section>

        </main>

    </div>

    <script src="app.js"></script>

</body>
</html>
